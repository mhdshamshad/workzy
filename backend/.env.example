PORT=3001
NODE_ENV=development
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/workzy_db
REDIS_URL=redis://127.0.0.1:6379

ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here
ACCESS_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=7

EMAIL_OTP_EXPIRY_SECONDS=900
REDIS_EXPIRY_SECONDS=604800

NODEMAILER_EMAIL=example@gmail.com
